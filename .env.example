# NetBird Management API — used by user-manage and policy-manage (load_dotenv).
# Copy to .env and fill in NETBIRD_TOKEN.
#
# Docs: https://docs.netbird.io/

NETBIRD_API_BASE=https://api.netbird.io
NETBIRD_TOKEN=

# Optional: group/policy name prefix for assignment (default nb → nb-{slug}-clients).
# NETBIRD_ASSIGN_NAME_PREFIX=nb

# expose-api only: bearer token clients must send; server still uses NETBIRD_TOKEN for NetBird.
# ASSIGN_SERVICE_TOKEN=

# ASSIGN_API_HOST=0.0.0.0
# ASSIGN_API_PORT=8080

# notify_netbird_passwords.py --send (NetEase enterprise / 网易企业邮箱)
# Put real values in .env only — never commit .env
# SCHOOL_EMAIL=you@nenu.edu.cn
# SCHOOL_EMAIL_HOST=smtphz.qiye.163.com
# SCHOOL_EMAIL_PORT=994
# SCHOOL_SMTP_PASSWORD=your-smtp-authorization-password
# SMTP_SSL=1
# SMTP_USE_TLS=0
# SMTP_DELAY_SECONDS=0.5
